# Ambil nilai-nilai ini dari Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Digunakan hanya di server (server actions) untuk operasi admin, JANGAN diexpose ke client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Nomor WhatsApp admin untuk tombol "Pesan via WhatsApp" (format: 62xxxxxxxxxxx tanpa tanda +)
NEXT_PUBLIC_WHATSAPP_NUMBER=6288228973096
